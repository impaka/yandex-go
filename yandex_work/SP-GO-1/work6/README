
; Даже если сейчас код и не нужно повторять несколько раз,
;  всё равно стоит выносить отдельные по смыслу части кода в функции.
;   Это помогает разделить и систематизировать его. Стремитесь к тому,
;   чтобы функции были небольшими и решали одну конкретную задачу.
;   Если функция получается слишком длинной,
;   возможно, стоит разбить её на несколько коротких.
package main

import (
	"fmt"
	"math"
)

// Название         Параметры с типом
func findDiscriminant(a, b, c float64) {
	// Тело функции
	discriminant := math.Pow(b, 2) - 4.0*a*c // Вычисления дискриминанта по формуле D = b^2 - 4*a*c
	fmt.Println(discriminant)
}

func main() {
	findDiscriminant(1, -3.0, 2) // a = 1  b = -3.0  c = 2
	// Вывод: 1

	findDiscriminant(1, 4.0, 2) // a = 1  b = 4.0   c = 2
	// Вывод: 8
}





; Возьмём на доработку уже полюбившуюся вам задачу «Go или не Go,
;  вот в чём вопрос». Напишите процедуру GoOrNot(),
;   которая принимает на вход строку и, если это строка Go,
;    выводит Go!, а если нет, то Я знаю только Go!.

; Формат ввода
; Процедура GoOrNot()
package main

import "fmt"

func GoOrNot(input string) {
	switch input {
	case "Go":
		fmt.Println("Go!")
	default:
		fmt.Println("Я знаю только Go!")
	}
}




Программист Арсений часто путешествует, но до сих пор с трудом находит нужную информацию
 на табло в аэропортах. Он решил сам запрограммировать простой и понятный вывод
 информации о полётах и предложить свою разработку аэропортовому руководству.

Помогите программисту-путешественнику и напишите процедуру PrintFlightRow().
;  Она должна принимать на вход номер рейса, города отправления и прибытия в виде строк,
;  продолжительность полёта в виде дробного числа часов с точностью до одного знака после
;  запятой, номер стойки регистрации и гейт в виде целых чисел, а также булевую переменную, закончилась ли регистрация (если true, то закончилась).
package main

import "fmt"

func PrintFlightRow(flightNumber, departurCity, arrivalCty string, flightDuration float64, registerNum, geyt int, register bool) {
	if !register {
		fmt.Printf("| %s | %s—%s | %d регистрация продолжается |\n",
			flightNumber,
			departurCity,
			arrivalCty,
			registerNum,
		)
	} else {
		fmt.Printf("| %s | %s—%s | регистрация закончилась, проходите к гейту: %d | длительность полёта %.1f часа |\n",
			flightNumber,
			departurCity,
			arrivalCty,
			geyt,
			flightDuration,
		)
	}
}

func main() {
	PrintFlightRow("117B", "Москва", "Казань", 2, 115, 3, false)
	PrintFlightRow("117B", "Москва", "Казань", 2, 115, 3, true)
}




; Напишите две процедуры: BuyFries() и BuyCola() для покупки соответствующего блюда.
;  На вход каждой из процедур подаётся размер в виде строки: S, M или L, а вывести нужно
;  Картошка фри будет стоить *количество* рублей или Кола будет стоить *количество* рублей.
package main

import "fmt"

func BuyFries(size string) string {
	var result string

	switch size {
	case "S":
		result = "Картошка фри будет стоить 49 рублей"
		fmt.Println(result)

	case "M":
		result = "Картошка фри будет стоить 89 рублей"
		fmt.Println(result)

	case "L":
		result = "Картошка фри будет стоить 99 рублей"
		fmt.Println(result)
	default:
		result = "Некорректный размер"
		fmt.Println(result)
	}
	return result
}

func BuyCola(size string) string {
	var result string
	switch size {
	case "S":
		result = "Кола будет стоить 99 рублей"
		fmt.Println(result)
	case "M":
		result = "Кола будет стоить 119 рублей"
		fmt.Println(result)

	case "L":
		result = "Кола будет стоить 139 рублей"
		fmt.Println(result)
	default:
		result = "Некорректный размер"
		fmt.Println(result)

	}
	return result
}
func printPrice(money int, product string) {

	fmt.Printf("%s будет стоить %d рублей\n", product, money)
}


; рекурсия 
package main

import "fmt"

func factorial(n int) int {
	// Крайний случай
	if n == 0 {
		return 1
	}

	// Вызов функции с текущим значением, умноженным на результат (n - 1)
	return n * factorial(n-1)
}

func main() {
	result := factorial(5)
	fmt.Println(result)
}
package main

import "fmt"

func fib(n int) int {
	// Крайний случай, так как при f(1) и далее мы не сможем посчитать обе следующих итерации
	if n < 2 {
		return n
	}

	return fib(n-1) + fib(n-2)
}

func main() {
	fmt.Println(fib(50)) // Вывод: 8
}




