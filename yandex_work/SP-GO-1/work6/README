		Balance += amount
		return nil
	}
	return AmountIsIncorrect
}
func chargeFromBalance(amount float64) error {
	if (Balance >= amount && amount != 0) && amount > 0 {
		Balance -= amount
		return nil
	}
	return AmountIsIncorrect

}
func TopUpAndGetBalance(amount float64) (float64, error) {
	if err := topUpBalance(amount); err != nil {
		return 0, err
	} else if Balance < 0 {
		return 0, BalanceIsIncorrect
	}
	return Balance, nil
}
func ChargeFromAndGetBalance(amount float64) (float64, error) {
	if err := chargeFromBalance(amount); err != nil {
		return 0, err
	} else if Balance < 0 {
		return 0, BalanceIsIncorrect
	}
	return Balance, nil
}
func main() {
