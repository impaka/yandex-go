; Помогите Арсению найти в тексте все буквы е и проверить, 
; не нужно ли заменить их на ё. Напишите функцию 
; CheckLetters(text string) string, которая проверяет текст на 
; наличие букв е. Если их нет, нужно вернуть: Текст готов к 
; публикации!, в ином случае: Количество возможных ошибок: 
; *число, количество букв е*, перепроверьте текст.

; Формат ввода
; Функция CheckLetters(text string) string

; Примечания
; Для решения этой задачи вам нужно самостоятельно найти 
; подходящие функции пакета strings.
package main

import (
	"fmt"
	"strings"
)

func CheckLetters(text string) string {
	count := strings.Count(text, "е")
	if count == 0 {
		return "Текст готов к публикации!"
	}
	return fmt.Sprintf("Количество возможных ошибок: %d, перепроверьте текст", count)
}
func main() {
	res := CheckLetters(" привет как дела")
	fmt.Println(res)
}





