; Напишите функцию CountLengthAndBytes(first, second string) string, 
; которая считает общее количество символов (рун) в двух строках и их суммарное 
; количество байт.

; На выход программа должна вернуть 
; строку: Объединённая строка: *объединённая строка из двух входных строк*. 
; Количество байт: *число байт*. 
; Количество символов: *число символов*.

; Формат ввода
; Функция CountLengthAndBytes(first, second string) string
package main

import "fmt"

func CountLengthAndBytes(first, second string) string {
	lenRune := len([]rune(first)) + len([]rune(second))
	len := len(first) + len(second)
	unification := first + second

	return fmt.Sprintf("Объединённая строка: %s. Количество байт: %d. Количество символов: %d.",
		unification,
		len,
		lenRune,
	)
}
func main() {
	res := CountLengthAndBytes("привет", "мир")
	fmt.Println(res)
}







; Программист Арсений любит ASCII и терпеть не может другие виды кодировок.

; Напишите функцию CheckOnlyASCII(s string) bool, которая проверяет, 
; символы какой кодировки содержатся в строке, и возвращает true, 
; если все они в ASCII, а false, если нет.

; Формат ввода
; Функция CheckOnlyASCII(s string) bool

; Примечания
; Для выполнения этой задачи вам поможет unicode.MaxASCII.
package main

import (
	"fmt"
	"unicode"
)

func CheckOnlyASCII(s string) bool {
	for _, sRune := range s {
		if sRune > unicode.MaxASCII {
			return false
		}
	}

	return true
}

func main() {
	fmt.Println(CheckOnlyASCII("Hello, Yandex!"))
	fmt.Println(CheckOnlyASCII("1 + 2 * 34 / 78"))
	fmt.Println(CheckOnlyASCII("~"))
	fmt.Println(CheckOnlyASCII(""))
}











; Помогите им и напишите функцию NumbersToLetters(input string) string, 
; которая получает на вход пример в виде цифр и арифметических знаков, 
; заменяет их на слова и возвращает. Замена должна происходить так:
package main

import "fmt"

func NumbersToLetters(input string) string {
	numWord := map[string]string{
		"0": "ноль",
		"1": "один",
		"2": "два",
		"3": "три",
		"4": "четыре",
		"5": "пять",
		"6": "шесть",
		"7": "семь",
		"8": "восемь",
		"9": "девять",
		"+": "плюс",
		"-": "минус",
		"*": "умножить на",
		"/": "разделить на",
	}
	var wordExample string
	for _, inpRune := range input {
		if _, ok := numWord[string(inpRune)]; ok {
			wordExample += numWord[string(inpRune)]
			continue
		}
		wordExample += string(inpRune)
	}
	return wordExample
}

func main() {
	res := NumbersToLetters("(1 + 2) * 3 / 8")
	fmt.Println(res)
}



// МАССИВЫ // 
package main

import "fmt"

func main() {
	candies := [5]string{"шоколадная", "ванильная", "клубничная", "карамельная", "лимонная"} // Инициализация массива конфет
	var sum int

	for i := 0; i < len(candies); i++ {
		// Съедаем конфету и добавляем её в сумму
		fmt.Println("Я съел конфету вкуса", candies[i])
		sum++
	}

	fmt.Println("Я съел", sum, "конфет")
}





; Напишите функцию FiveSteps(array [5]int) [5]int, 
; которая принимает массив из пяти целочисленных элементов. 
; Программа должна возвращать значения элементов массива в обратном порядке.

; Формат ввода
; Функция FiveSteps(array [5]int) [5]int
package main

import "fmt"

func FiveSteps(array [5]int) [5]int {
	recive := [5]int{}
	var z int
	for i := len(array) - 1; i >= 0; i-- {

		recive[z] = array[i]
		z++
	}
	return recive
}

func main() {
	array := [5]int{1, 2, 3, 4, 5}
	fmt.Println(FiveSteps(array), array)
}









